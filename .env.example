# Copy this file to .env and fill in your values

# YouTube Data API v3 key (required for custom playlist feature)
# Get one free at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# (Optional) Restrict Socket.IO CORS to your deployed domain
# ALLOWED_ORIGIN=https://your-app.onrender.com

# (Optional) Port (defaults to 3000)
# PORT=3000

# NODE_ENV=production
